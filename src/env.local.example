GROQ_API_KEY=your_groq_key_here
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-the-token-configured-by-your-python-backend
HF_TOKEN=your_hugging_face_token_with_inference_permission
